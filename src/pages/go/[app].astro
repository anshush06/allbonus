---
// /go/<app>/ — the only place a referral URL is emitted. Cards and buttons link
// here, so changing an app's referral_url in the admin updates every link.
import { getApps, type App } from '../../lib/content';

export async function getStaticPaths() {
  return (await getApps()).map((app) => ({ params: { app: app.id }, props: { app } }));
}
const { app } = Astro.props as { app: App };
const url = app.data.referral_url;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <title>Opening {app.data.name}…</title>
  </head>
  <body style="font-family:system-ui,sans-serif;text-align:center;padding:3rem 1rem">
    <p>Opening {app.data.name}… <a href={url} rel="sponsored nofollow">Tap here if nothing happens</a>.</p>
  </body>
</html>
