---
import Icon from './Icon.astro';
import { md } from '../lib/markdown';
import type { IconName } from '../lib/icons';
interface Props { title: string; icon?: IconName; body?: string }
const { title, icon = 'info', body } = Astro.props;
---
<section class="card">
  <h2 class="card-title"><Icon name={icon} size={18} />{title}</h2>
  <div class="prose-content">{body && <Fragment set:html={md(body)} />}<slot /></div>
</section>
